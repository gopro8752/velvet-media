diff --git a/services/foxone-safety.ts b/services/foxone-safety.ts
new file mode 100644
index 0000000..6602e1d
--- /dev/null
+++ b/services/foxone-safety.ts
@@ -0,0 +1,87 @@
+// Local hardening for EPlusTV. The upstream MIT license remains in LICENSE.
+
+export interface FoxOneTuneRequest {
+  signal: AbortSignal;
+  timeout: number;
+}
+
+interface FoxOneTuneLimits {
+  attempts: number;
+  timeoutMs: number;
+  requestTimeoutMs: number;
+}
+
+const TUNE_LIMITS: FoxOneTuneLimits = {attempts: 3, timeoutMs: 20000, requestTimeoutMs: 8000};
+
+class FoxOneTuneError extends Error {
+  constructor(public readonly reason: 'playback-timeout' | 'invalid-playback-response') {
+    super(reason);
+  }
+}
+
+// Bound malformed-response retries and the entire tune, including DNS/connect waits.
+// Axios receives the same abort signal so timeout does not leave requests running.
+export const resolveFoxOnePlayback = async (
+  resolve: (request: FoxOneTuneRequest) => Promise<any>,
+  limits: FoxOneTuneLimits = TUNE_LIMITS,
+): Promise<string> => {
+  const controller = new AbortController();
+  const deadline = Date.now() + limits.timeoutMs;
+  let timer: ReturnType<typeof setTimeout>;
+  const expired = new Promise<never>((_, reject) => {
+    timer = setTimeout(() => {
+      reject(new FoxOneTuneError('playback-timeout'));
+      controller.abort();
+    }, limits.timeoutMs);
+  });
+
+  const tune = async () => {
+    for (let attempt = 0; attempt < limits.attempts; attempt++) {
+      if (controller.signal.aborted || Date.now() >= deadline) {
+        throw new FoxOneTuneError('playback-timeout');
+      }
+      const data = await resolve({
+        signal: controller.signal,
+        timeout: Math.max(1, Math.min(limits.requestTimeoutMs, deadline - Date.now())),
+      });
+      const url = data?.stream?.playbackUrl;
+      if (typeof url === 'string' && url.trim()) {
+        return url;
+      }
+    }
+    throw new FoxOneTuneError('invalid-playback-response');
+  };
+
+  try {
+    return await Promise.race([tune(), expired]);
+  } finally {
+    clearTimeout(timer);
+    controller.abort();
+  }
+};
+
+// Never stringify provider bodies, Axios configs, URLs, or messages: any may
+// contain authorization tokens, account details, or signed playback URLs.
+export const foxOneErrorSummary = (error: unknown): string => {
+  if (error instanceof FoxOneTuneError) {
+    return error.reason;
+  }
+  const failure = error as {response?: {status?: unknown}; code?: unknown} | null;
+  const status = failure?.response?.status;
+  if (typeof status === 'number' && Number.isInteger(status) && status >= 100 && status <= 599) {
+    const reasons: Record<number, string> = {
+      400: 'request rejected',
+      401: 'authentication required',
+      403: 'authorization refused',
+      404: 'not found',
+      410: 'authorization expired',
+      429: 'rate limited',
+    };
+    return `HTTP ${status}: ${reasons[status] || (status >= 500 ? 'upstream unavailable' : 'request failed')}`;
+  }
+  const codes = ['ECONNABORTED', 'ETIMEDOUT', 'ERR_CANCELED', 'ENOTFOUND', 'ECONNREFUSED', 'ECONNRESET'];
+  if (typeof failure?.code === 'string' && codes.includes(failure.code)) {
+    return failure.code;
+  }
+  return 'request failed';
+};
