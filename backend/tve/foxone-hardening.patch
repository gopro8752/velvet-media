index 0000000..cb27ceb
--- /dev/null
+++ b/tests/foxone-safety.test.cjs
@@ -0,0 +1,230 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const {createRequire} = require('node:module');
+const {test} = require('node:test');
+const http = require('node:http');
+const ts = require('typescript');
+const axios = require('axios');
+
+const root = path.resolve(__dirname, '..');
+const sentinel = 'TEST_ONLY_SECRET_SENTINEL';
+
+function loadSource(relative, overrides = {}, logger = console) {
+  const filename = path.join(root, relative);
+  const compiled = ts.transpileModule(fs.readFileSync(filename, 'utf8'), {
+    compilerOptions: {
+      target: ts.ScriptTarget.ES2020,
+      module: ts.ModuleKind.CommonJS,
+      esModuleInterop: true,
+      jsx: ts.JsxEmit.ReactJSX,
+      jsxImportSource: 'hono/jsx',
+    },
+  }).outputText;
+  const module = {exports: {}};
+  const localRequire = createRequire(filename);
+  const getModule = name => Object.hasOwn(overrides, name) ? overrides[name] : localRequire(name);
+  vm.runInThisContext(`(function(require,module,exports,console){${compiled}\n})`, {filename})(
+    getModule, module, module.exports, logger,
+  );
+  return module.exports;
+}
+
+const safety = loadSource('services/foxone-safety.ts');
+
+function makeHandler(client, uhd = false, storedProvider) {
+  const logs = [];
+  const logger = Object.fromEntries(['log', 'warn', 'error'].map(level => [level, (...args) => logs.push(args)]));
+  const database = {providers: {
+    findOneAsync: async () => storedProvider || ({meta: {uhd}, tokens: {}, enabled: true}),
+    countAsync: async () => 1,
+    updateAsync: async () => {},
+  }};
+  const {foxOneHandler: handler} = loadSource('services/foxone-handler.ts', {
+    axios: client,
+    './user-agent': {androidFoxOneUserAgent: 'fixture-agent'},
+    './config': {configPath: '/unused-fixture'},
+    './networks': {},
+    './adobe-helpers': {},
+    './shared-helpers': {getRandomHex: () => '0123456789abcdef0123456789abcdef'},
+    './shared-interfaces': {},
+    './database': {db: database},
+    './debug': {},
+    './misc-db-service': {},
+    './foxone-safety': safety,
+  }, logger);
+  handler.appConfig = {network: {apikey: sentinel, identity: {regcodeUrl: '/register'}}};
+  handler.adobe_auth = {accessToken: sentinel};
+  handler.adobe_prelim_auth_token = {accessToken: sentinel};
+  return {handler, logs};
+}
+
+test('a valid playback URL does not require CDN metadata or repeat a request', async () => {
+  const calls = [];
+  const {handler} = makeHandler({post: async (...args) => {
+    calls.push(args);
+    return {data: {stream: {cdn: '', playbackUrl: 'https://media.example/stream.m3u8'}}};
+  }});
+  const result = await handler.getEventData('event-1');
+  assert.equal(result[0], 'https://media.example/stream.m3u8');
+  assert.equal(result[1]['User-Agent'], 'fixture-agent');
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0][1].asset.id, 'event-1');
+  assert.equal(calls[0][2].headers.authorization, sentinel);
+  assert.equal(calls[0][2].headers['x-device-capabilities'], 'color/SDR,maxRes/HD');
+  assert.ok(calls[0][2].timeout > 0 && calls[0][2].timeout <= 8000);
+  assert.ok(calls[0][2].signal instanceof AbortSignal);
+});
+
+test('malformed responses stop after three attempts instead of looping', async () => {
+  let calls = 0;
+  const {handler, logs} = makeHandler({post: async () => {
+    calls++;
+    return {data: {stream: {cdn: ''}}};
+  }});
+  assert.equal(await handler.getEventData('event-1'), undefined);
+  assert.equal(calls, 3);
+  assert.match(JSON.stringify(logs), /invalid-playback-response/);
+});
+
+test('an authorization refusal retains safe HTTP status and is not retried as a missing CDN', async () => {
+  let calls = 0;
+  const {handler, logs} = makeHandler({post: async () => {
+    calls++;
+    throw {response: {status: 403, data: {message: sentinel}}, config: {headers: {authorization: sentinel}}};
+  }});
+  assert.equal(await handler.getEventData('event-1'), undefined);
+  assert.equal(calls, 1);
+  const logged = JSON.stringify(logs);
+  assert.match(logged, /HTTP 403: authorization refused/);
+  assert.ok(!logged.includes(sentinel));
+});
+
+test('existing UHD to HD fallback and authorization headers are preserved', async () => {
+  const capabilities = [];
+  const {handler} = makeHandler({post: async (_url, _body, request) => {
+    capabilities.push(request.headers['x-device-capabilities']);
+    assert.equal(request.headers.authorization, sentinel);
+    if (capabilities.length === 1) throw {response: {status: 503}};
+    return {data: {stream: {playbackUrl: 'https://media.example/hd.m3u8'}}};
+  }}, true);
+  assert.equal((await handler.getEventData('event-1'))[0], 'https://media.example/hd.m3u8');
+  assert.deepEqual(capabilities, ['color/HDR,maxRes/UHD', 'color/SDR,maxRes/HD']);
+});
+
+test('tuning deadline aborts a real stalled HTTP request', async () => {
+  const sockets = new Set();
+  const server = http.createServer(() => {});
+  server.on('connection', socket => {
+    sockets.add(socket);
+    socket.on('close', () => sockets.delete(socket));
+  });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  let signal;
+  let calls = 0;
+  const start = Date.now();
+  try {
+    await assert.rejects(safety.resolveFoxOnePlayback(request => {
+      calls++;
+      signal = request.signal;
+      return axios.get(`http://127.0.0.1:${server.address().port}/stall`, request);
+    }, {attempts: 3, timeoutMs: 40, requestTimeoutMs: 1000}), error => {
+      assert.equal(safety.foxOneErrorSummary(error), 'playback-timeout');
+      return true;
+    });
+    assert.equal(signal.aborted, true);
+    assert.equal(calls, 1);
+    assert.ok(Date.now() - start < 1000);
+  } finally {
+    for (const socket of sockets) socket.destroy();
+    await new Promise(resolve => server.close(resolve));
+  }
+});
+
+test('safe failure summaries omit all arbitrary provider fields and messages', () => {
+  const malicious = {
+    response: {status: 401, data: {reason: sentinel, accessToken: sentinel}},
+    config: {url: `https://example.test/?token=${sentinel}`, headers: {authorization: sentinel}},
+    request: {headers: sentinel},
+    message: sentinel,
+    code: sentinel,
+  };
+  assert.equal(safety.foxOneErrorSummary(malicious), 'HTTP 401: authentication required');
+  assert.equal(safety.foxOneErrorSummary({...malicious, response: undefined}), 'request failed');
+  assert.equal(safety.foxOneErrorSummary({code: 'ECONNRESET'}), 'ECONNRESET');
+  assert.equal(safety.foxOneErrorSummary(null), 'request failed');
+});
+
+test('device-code auth returns the code without logging it', async () => {
+  const {handler, logs} = makeHandler({post: async (_url, body) => {
+    assert.equal(body.isMvpd, true);
+    return {data: {code: sentinel}};
+  }});
+  handler.getPrelimToken = async () => {};
+  assert.equal(await handler.getAuthCode(), sentinel);
+  assert.ok(!JSON.stringify(logs).includes(sentinel));
+});
+
+test('a disabled provider restores pending device-code auth after restart without network requests', async () => {
+  const savedDevice = 'fixture-pending-device';
+  const savedPrelim = {accessToken: sentinel, tokenExpiration: Date.now() + 86400000};
+  let networkRequests = 0;
+  const {handler} = makeHandler(new Proxy({}, {
+    get: (_target, method) => method === '__esModule' ? false : async () => {networkRequests++; throw new Error('Unexpected network request');},
+  }), false, {enabled: false, meta: {}, tokens: {
+    adobe_device_id: savedDevice,
+    adobe_prelim_auth_token: savedPrelim,
+  }});
+  handler.adobe_device_id = undefined;
+  handler.adobe_prelim_auth_token = undefined;
+  handler.adobe_auth = undefined;
+  await handler.initialize();
+  assert.equal(handler.adobe_device_id, savedDevice);
+  assert.equal(handler.adobe_prelim_auth_token, savedPrelim);
+  assert.equal(handler.adobe_auth, undefined);
+  assert.equal(networkRequests, 0);
+});
+
+test('auth polling keeps its false result and logs only safe provider status', async () => {
+  const {handler, logs} = makeHandler({get: async () => {
+    throw {response: {status: 401, data: sentinel}, config: {headers: {authorization: sentinel}}};
+  }});
+  assert.equal(await handler.authenticateRegCode(false), false);
+  assert.match(JSON.stringify(logs), /HTTP 401/);
+  assert.ok(!JSON.stringify(logs).includes(sentinel));
+});
+
+test('home preferences are read from FOX without any account update', async () => {
+  const calls = [];
+  const {handler} = makeHandler({
+    put: async () => {throw new Error('Home preferences must not be written');},
+    get: async url => {
+      calls.push(['GET', url]);
+      return {data: {data: {results: [{key: 'HOME_LOCATION', value: {home_zip_code: '11111', home_metro_code: 'original-dma'}}]}}};
+    },
+    post: async (url, body) => {
+      calls.push(['POST', url]);
+      assert.deepEqual(body, {user_entitlement: ['original-entitlement']});
+      return {data: {data: {headers: [{key: 'x-fox-content-entitlement', value: 'entitlement-header'}]}}};
