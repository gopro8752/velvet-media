# Copy to .env and supply your own values. Never commit .env.
VELVET_PUBLIC_BASE_URL=https://velvet.example.com
VELVET_TOKEN=
VELVET_TMDB_KEY=
NNTP_HOST=news.example.com
NNTP_USER=
NNTP_PASS=
NNTP_CONNS=10
# Bind the host to loopback by default. Configure a trusted reverse proxy.
VELVET_BIND_ADDRESS=127.0.0.1
VELVET_PORT=8799
# Optional AI category runtime: change runtime to with-codex.
VELVET_IMAGE_TARGET=runtime
