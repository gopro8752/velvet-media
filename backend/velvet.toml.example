# Copy to config/velvet.toml, protect it, and supply your own service details.
# Docker Compose supplies the public URL, shared token and first provider from .env.
bind = "0.0.0.0"
port = 8799
public_base_url = "https://velvet.example.com"
token = ""
db_path = "/data/velvet.db"

# Provider order is failover priority. Match max_connections to your plan.
# NNTP_HOST, NNTP_USER, NNTP_PASS and NNTP_CONNS override the first provider.
[[providers]]
name = "Primary"
host = "news.example.com"
port = 563
tls = true
username = ""
password = ""
max_connections = 10

# Add your own Newznab-compatible indexer(s); remove this block until configured.
[[indexers]]
name = "My indexer"
url = "https://indexer.example.com"
api_key = ""

# Optional AI categories. Build with --target with-codex and authenticate the
# official CLI in the private config volume. No credentials are included.
[category_ai]
enabled = false
codex_path = "codex"
codex_home = "/config/codex"
# model = "MODEL_AVAILABLE_TO_YOUR_ACCOUNT"

# Optional live-channel bridge, configured and authenticated separately.
# The bundled adapter supports PrismCast's Spectrum playlist format.
[live_tv]
enabled = false
source_name = "Live TV"
upstream_url = "http://live-bridge:5589"
lineup_path = "/playlist?service=spectrum"
guide_enabled = false
# Optional direct EPlusTV origin. Dedicated linear channels and proxied segments
# must be enabled there. Only reviewed national feeds use it; Spectrum stays the
# full lineup, guide identity, and fallback. Leave unset until authenticated and
# tested. Provider logins belong in the bridge's private runtime storage.
# direct_tve_url = "http://velvet-tve:8000"
# Optional native Spectrum service: full account lineup with device DRM.
# When set, Live TV never falls back to browser capture. Update every client
# before enabling. upstream_url still serves the separate Roku sports bridge.
# native_spectrum_url = "http://velvet-spectrum:8812"

# Optional external event discovery/embed adapter; no channels are bundled.
[live_sports]
enabled = false

# Beta exact-byte recovery. Disabled unless explicitly enabled on an isolated
# beta instance. Repair files and metadata belong on a private writable volume.
[repair]
enabled = false
cache_dir = "/data/recovery"
max_job_bytes = 17179869184
max_cache_bytes = 34359738368
max_jobs = 1
max_job_seconds = 180

# Real packet timestamps from ffprobe, never duration * file-size estimates.
[stream_buffer]
enabled = false
lookahead_seconds = 90
max_probe_bytes = 268435456
max_probe_seconds = 40
max_memory_bytes = 268435456
heartbeat_timeout_seconds = 15
ffprobe_binary = "ffprobe"
