{
  "manifest_version": 2,
  "name": "Velvet sports startup",
  "version": "1.1.5",
  "browser_specific_settings": {
    "gecko": {
      "id": "sports-startup@velvet.local"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://strmfree.st/embed/*",
        "https://streamfree.top/embed/*"
      ],
      "js": [
        "startup.js"
      ],
      "all_frames": false,
      "run_at": "document_end"
    }
  ]
}
