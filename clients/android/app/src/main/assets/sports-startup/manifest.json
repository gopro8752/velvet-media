{
  "manifest_version": 2,
  "name": "Velvet sports startup",
  "version": "1.0.5",
  "browser_specific_settings": { "gecko": { "id": "sports-startup@velvet.local" } },
  "permissions": ["geckoViewAddons", "nativeMessaging", "nativeMessagingFromContent"],
  "content_scripts": [{
    "matches": ["https://embed.st/embed/*", "https://embed.pk/embed/*", "https://rockylive.st/source/streamed1.php*", "https://rockylive.st/source/streamed.php*"],
    "js": ["startup.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
