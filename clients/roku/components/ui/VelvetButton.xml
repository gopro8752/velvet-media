<?xml version="1.0" encoding="utf-8" ?>
<component name="VelvetButton" extends="Group">
  <interface>
    <field id="label" type="string" onChange="updateStyle" />
    <field id="subtitle" type="string" onChange="updateStyle" />
    <field id="icon" type="string" onChange="updateStyle" />
    <field id="width" type="float" value="264" onChange="updateStyle" />
    <field id="height" type="float" value="72" onChange="updateStyle" />
    <field id="accent" type="boolean" onChange="updateStyle" />
    <field id="centered" type="boolean" onChange="updateStyle" />
    <field id="primary" type="boolean" onChange="updateStyle" />
    <field id="enabled" type="boolean" value="true" onChange="updateStyle" />
    <field id="focused" type="boolean" onChange="updateStyle" />
    <field id="selected" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/ui/VelvetButton.brs" />
  <children>
    <Poster id="fill" uri="pkg:/images/button.9.png" />
    <Poster id="rim" translation="[-3,-3]" uri="pkg:/images/button-focus.9.png" opacity="0" />
    <Poster id="icon" width="30" height="30" loadDisplayMode="scaleToFit" />
    <Label id="label" color="0xF2F4F8FF" height="42" vertAlign="center">
      <Font role="font" uri="pkg:/fonts/Outfit-Medium.ttf" size="29" />
    </Label>
    <Label id="subtitle" color="0x9BA3B4FF" height="30">
      <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="20" />
    </Label>
  </children>
</component>
